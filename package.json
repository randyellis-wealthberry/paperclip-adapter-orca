{
  "name": "paperclip-adapter-orca",
  "version": "0.1.0",
  "description": "Paperclip adapter + sync plugin: run agents in Orca worktrees, review in Orca",
  "type": "module",
  "license": "MIT",
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./plugin/manifest": "./dist/plugin/manifest.js",
    "./plugin/worker": "./dist/plugin/worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/*.test.js dist/plugin/*.test.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.916.1",
    "@paperclipai/plugin-sdk": "^2026.916.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "paperclipPlugin": {
    "manifest": "./dist/plugin/manifest.js",
    "worker": "./dist/plugin/worker.js"
  },
  "keywords": [
    "paperclip",
    "paperclip-adapter",
    "paperclip-plugin",
    "orca",
    "claude-code",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/randyellis-wealthberry/paperclip-adapter-orca.git"
  },
  "homepage": "https://github.com/randyellis-wealthberry/paperclip-adapter-orca#readme",
  "bugs": {
    "url": "https://github.com/randyellis-wealthberry/paperclip-adapter-orca/issues"
  }
}
